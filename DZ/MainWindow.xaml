<Window x:Class="DZ.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DZ"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <!-- Calculator -->
        <Border Grid.Column="0" BorderBrush="LightGray" BorderThickness="1" CornerRadius="8" Padding="8" Margin="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBox x:Name="CalcDisplay" Grid.Row="0" Height="48" FontSize="20" IsReadOnly="True" TextAlignment="Right" VerticalContentAlignment="Center" />

                <UniformGrid Grid.Row="1" Rows="5" Columns="4" Margin="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <!-- Row 1 -->
                    <Button Content="7" Click="Button_Digital_Click" />
                    <Button Content="8" Click="Button_Digital_Click" />
                    <Button Content="9" Click="Button_Digital_Click" />
                    <Button Content="/" Click="Button_Operator_Click" />

                    <!-- Row 2 -->
                    <Button Content="4" Click="Button_Digital_Click" />
                    <Button Content="5" Click="Button_Digital_Click" />
                    <Button Content="6" Click="Button_Digital_Click" />
                    <Button Content="*" Click="Button_Operator_Click" />

                    <!-- Row 3 -->
                    <Button Content="1" Click="Button_Digital_Click" />
                    <Button Content="2" Click="Button_Digital_Click" />
                    <Button Content="3" Click="Button_Digital_Click" />
                    <Button Content="-" Click="Button_Operator_Click" />

                    <!-- Row 4 -->
                    <Button Content="0" Click="Button_Digital_Click" />
                    <Button Content="." Click="Button_Digital_Click" />
                    <Button Content="=" Click="Button_Equals_Click" />
                    <Button Content="+" Click="Button_Operator_Click" />

                    <!-- Row 5 (clear and spacer) -->
                    <Button Content="C" Click="Button_Clear_Click" />
                    <Button Content="( )" Click="Button_Paren_Click" />
                    <Button Content="" IsEnabled="False" />
                    <Button Content="" IsEnabled="False" />
                </UniformGrid>
            </Grid>
        </Border>

        <!-- Demos / Output -->
        <Border Grid.Column="1" BorderBrush="LightGray" BorderThickness="1" CornerRadius="8" Padding="8" Margin="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,8">
                    <Button Content="Демо фігур" Click="BtnShapes_Click" Margin="0,0,8,0" />
                    <Button Content="Демо виключень" Click="BtnExceptions_Click" Margin="0,0,8,0" />
                    <Button Content="Демо притулку" Click="BtnShelter_Click" Margin="0,0,8,0" />
                </StackPanel>

                <TextBox x:Name="OutputBox" Grid.Row="1" TextWrapping="Wrap" IsReadOnly="True" VerticalScrollBarVisibility="Auto" />
            </Grid>
        </Border>
    </Grid>
</Window>
